// Diagrammer Shadow Grammar in Pest

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ "//" ~ (!"\n" ~ ANY)* }

COLOR = @{ "#" ~ ASCII_HEX_DIGIT{6} }
VARIABLE = @{ "$(" ~ (!")" ~ ANY)+ ~ ")" }
INLINE_STRING = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
COMPASS_DIR = @{
    (^"nw" | ^"ne" | ^"n" | ^"sw" | ^"se" | ^"s" | ^"e" | ^"w")
    ~ !(ASCII_ALPHANUMERIC | "_")
}
COMPASS = @{ ":" ~ COMPASS_DIR }
LABEL = @{ ";" ~ (!"\n" ~ ANY)* }
IMAGE = @{ "/" ~ ASCII_ALPHANUMERIC+ ~ ".png" }
NUMBER = @{ ASCII_DIGIT+ }

SHAPES = @{
    (^"actor" | ^"beginpoint" | ^"right" | ^"circle" | ^"cloud" | ^"condition" | ^"database" |
     ^"default" | ^"diamond" | ^"dots" | ^"doublecircle" | ^"ellipse" | ^"endpoint" | ^"input" |
     ^"loopin" | ^"loopout" | ^"mail" | ^"document" | ^"display" | ^"note" | ^"record" |
     ^"roundedbox" | ^"square" | ^"left" | ^"loop" | ^"subroutine" | ^"preparation" | ^"rect" | ^"folder")
    ~ !(ASCII_ALPHANUMERIC | "_")
}

STYLES = @{
    (^"dotted" | ^"dashed" | ^"solid" | ^"bold" | ^"rounded" | ^"diagonals" | ^"invis" | ^"singularity")
    ~ !(ASCII_ALPHANUMERIC | "_")
}

// Edge symbols (mirroring Jison grammar EVENT token regex, extended for multi-char lines like -->, ..>, ==>, |-->)
LINE_CHAR = _{ "." | "=" | "-" | "~" | "*" | ("/" ~ !"/") }
EVENT = @{
    ("<<" | "<" | "|") ~ LINE_CHAR* ~ (">>" | ">" | "|")
  | ("<<" | "<" | "|") ~ LINE_CHAR+
  | LINE_CHAR+ ~ (">>" | ">" | "|")
  | ("<<" | "<" | "|")
  | (">>" | ">" | "|")
  | LINE_CHAR+
}

NAME = @{ (ASCII_ALPHA | "!") ~ (ASCII_ALPHANUMERIC | "_" | "!")* ~ (":" ~ !COMPASS_DIR ~ (ASCII_ALPHANUMERIC | "_" | "!")*)? }

color_or_variable = { COLOR | VARIABLE }
shape_or_variable = { SHAPES | VARIABLE }

landscape = @{ (^"landscape" | ^"horizontal" | ^"lr") ~ !(ASCII_ALPHANUMERIC | "_") }
portrait = @{ (^"portrait" | ^"vertical" | ^"td") ~ !(ASCII_ALPHANUMERIC | "_") }
VISUALIZER_KW = @{ ^"visualizer" ~ !(ASCII_ALPHANUMERIC | "_") }
visualizer = { VISUALIZER_KW ~ NAME }
START_KW = @{ ^"start" ~ !(ASCII_ALPHANUMERIC | "_") }
start = { START_KW ~ NAME }
EQUAL_KW = @{ ^"equal" ~ !(ASCII_ALPHANUMERIC | "_") }
equal = { EQUAL_KW ~ vertex_target }
SHAPE_KW = @{ ^"shape" ~ !(ASCII_ALPHANUMERIC | "_") }
shape_decl = { SHAPE_KW ~ shape_or_variable }

edge_color = { ^"edge" ~ ^"color" ~ color_or_variable }
edge_text_color = { ^"edge" ~ (^"textcolor" | ^"text" ~ ^"color") ~ color_or_variable }
vertex_color = { ^"vertex" ~ ^"color" ~ color_or_variable }
vertex_text_color = { ^"vertex" ~ (^"textcolor" | ^"text" ~ ^"color") ~ color_or_variable }
group_color = { ^"group" ~ ^"color" ~ color_or_variable }

IF_KW = @{ ^"if" ~ !(ASCII_ALPHANUMERIC | "_") }
if_stmt = { IF_KW ~ (!^"then" ~ ANY)+ ~ ^"then" }
elseif_stmt = { ^"else" ~ ^"if" ~ (!^"then" ~ ANY)+ ~ ^"then" }
ELSE_KW = @{ ^"else" ~ !(ASCII_ALPHANUMERIC | "_") }
else_stmt = { ELSE_KW }
endif_stmt = { ^"end" ~ ^"if" }
WHILE_KW = @{ ^"while" ~ !(ASCII_ALPHANUMERIC | "_") }
LINE_REST = @{ (!"\n" ~ ANY)+ }
while_stmt = { WHILE_KW ~ LINE_REST }
endwhile_stmt = { ^"end" ~ ^"while" }
DO_KW = @{ ^"do" ~ !(ASCII_ALPHANUMERIC | "_") }
do_stmt = { DO_KW }
UNTIL_KW = @{ ^"until" ~ !(ASCII_ALPHANUMERIC | "_") }
until_stmt = { UNTIL_KW ~ LINE_REST }

THEME_KW = @{ ^"theme" ~ !(ASCII_ALPHANUMERIC | "_") }
LAYOUT_KW = @{ ^"layout" ~ !(ASCII_ALPHANUMERIC | "_") }
INCLUDE_KW = @{ ^"include" ~ !(ASCII_ALPHANUMERIC | "_") }

theme_key = @{ (ASCII_ALPHANUMERIC | "_" | "-")+ }
theme_value = @{ INLINE_STRING | COLOR | VARIABLE | (!(";" | "\n" | "}" | "\r" | "//") ~ ANY)+ }
theme_entry = { theme_key ~ (":" | "=")? ~ theme_value ~ ";"? }
theme_block = { THEME_KW ~ "{" ~ theme_entry* ~ "}" }

layout_key = @{ (ASCII_ALPHANUMERIC | "_" | "-")+ }
layout_value = @{ INLINE_STRING | COLOR | VARIABLE | (!(";" | "\n" | "}" | "\r" | "//") ~ ANY)+ }
layout_entry = { layout_key ~ (":" | "=")? ~ layout_value ~ ";"? }
layout_block = { LAYOUT_KW ~ "{" ~ layout_entry* ~ "}" }

include_path = @{ (ASCII_ALPHANUMERIC | "_" | "-" | "." | "/" | "\\")+ }
include_target = { INLINE_STRING | include_path }
include_block = { INCLUDE_KW ~ "{" ~ (include_target ~ ";"?)* ~ "}" }
include_stmt = { INCLUDE_KW ~ include_target }

DEFINE_KW = @{ ^"define" ~ !(ASCII_ALPHANUMERIC | "_") }
OPERATOR_KW = @{ ^"operator" ~ !(ASCII_ALPHANUMERIC | "_") }
define_name = @{ !OPERATOR_KW ~ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
define_param_key = @{ ASCII_ALPHA+ }
define_param_val = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }
define_param = { define_param_key ~ "=" ~ define_param_val }
define_params = { "(" ~ (define_param ~ ("," ~ define_param)*)? ~ ","? ~ ")" }

geom_kw = @{
    (^"rectangle" | ^"rect" | ^"circle" | ^"ellipse" | ^"polygon" | ^"polyline" | ^"path" | ^"line")
    ~ !(ASCII_ALPHANUMERIC | "_")
}
geom_args = @{ (!")" ~ ANY)* }
geom_primitive = { geom_kw ~ "(" ~ geom_args ~ ")" }

raw_svg = ${ ^"<svg" ~ (!^"</svg>" ~ ANY)* ~ ^"</svg>" }

define_statement = { (raw_svg | geom_primitive) ~ ";"? }
define_block = { DEFINE_KW ~ define_name ~ define_params? ~ "{" ~ define_statement* ~ "}" }

op_type_kw = @{ (^"bidirectional" | ^"directed" | ^"undirected" | ^"double" | ^"flat" | ^"none") ~ !(ASCII_ALPHANUMERIC | "_") }
op_style_kw = @{ (^"solid" | ^"dashed" | ^"dotted" | ^"bold" | ^"double" | ^"invis") ~ !(ASCII_ALPHANUMERIC | "_") }
arrowhead_kw = @{ ^"arrowhead" ~ !(ASCII_ALPHANUMERIC | "_") }

arrowhead_entry = { arrowhead_kw ~ define_params? ~ ":" ~ (SHAPES | custom_shape | custom_type) ~ ("(" ~ geom_args ~ ")")? ~ ";"? }
op_type_entry = { ^"type" ~ ":" ~ op_type_kw ~ ";"? }
op_style_entry = { ^"style" ~ ":" ~ op_style_kw ~ ";"? }
op_color_entry = { ^"color" ~ ":" ~ color_or_variable ~ ";"? }
op_action_val = @{ (ASCII_ALPHANUMERIC | "_" | "-")+ }
op_action_entry = { ^"action" ~ ":" ~ op_action_val ~ ";"? }

operator_entry = {
    arrowhead_entry
  | op_type_entry
  | op_style_entry
  | op_color_entry
  | op_action_entry
}

define_operator_block = {
    DEFINE_KW ~ OPERATOR_KW ~ EVENT ~ "{" ~ operator_entry* ~ "}"
}

custom_type = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
custom_shape = @{ "__custom_shape__" ~ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }

SAME_LINE_SPACE = _{ " " | "\t" }
GROUP_KW = @{ ^"group" ~ !(ASCII_ALPHANUMERIC | "_") }
group_start = ${ (GROUP_KW | "{") ~ SAME_LINE_SPACE* ~ "!"? ~ SAME_LINE_SPACE* ~ NAME? ~ SAME_LINE_SPACE* ~ color_or_variable? ~ SAME_LINE_SPACE* ~ LABEL? }
group_end = { GROUP_KW ~ ^"end" | "}" }

vertex_name_spec = ${
    STYLES ~ SAME_LINE_SPACE+ ~ (SHAPES | custom_shape) ~ SAME_LINE_SPACE+ ~ NAME
  | STYLES ~ SAME_LINE_SPACE+ ~ NAME
  | (SHAPES | custom_shape) ~ SAME_LINE_SPACE+ ~ NAME
  | SHAPES
  | NAME
}

vertex_attrs = {
    vertex_name_spec
    ~ (COMPASS ~ color_or_variable? | color_or_variable ~ COMPASS?)?
    ~ IMAGE?
}

list_item = { INLINE_STRING? ~ vertex_attrs }
vertex_list = { list_item ~ ("," ~ list_item)+ }

inner_graph = { "(" ~ (statement ~ ("," | ";")?)* ~ ")" }

vertex_target = {
    inner_graph
  | vertex_list
  | list_item
}

edge_connector = { COMPASS? ~ EVENT ~ COMPASS? ~ color_or_variable? ~ INLINE_STRING? }

event_chain = {
    vertex_target ~ (edge_connector ~ vertex_target)+ ~ LABEL?
  | vertex_target ~ LABEL
}

statement = {
    landscape
  | portrait
  | visualizer
  | start
  | equal
  | shape_decl
  | edge_color
  | edge_text_color
  | vertex_color
  | vertex_text_color
  | group_color
  | if_stmt
  | elseif_stmt
  | else_stmt
  | endif_stmt
  | while_stmt
  | endwhile_stmt
  | do_stmt
  | until_stmt
  | theme_block
  | layout_block
  | include_block
  | include_stmt
  | define_operator_block
  | define_block
  | group_start
  | group_end
  | VARIABLE
  | event_chain
  | vertex_target
}

diagram = { SOI ~ statement* ~ EOI }
